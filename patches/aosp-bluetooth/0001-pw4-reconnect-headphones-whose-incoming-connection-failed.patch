+    // Readom (PW4): an incoming connection that failed is made again from this
+    // side. The PW4 offers SBC only (device/amazon/pw4 Bluetooth overlay, to keep
+    // the single core free), and some headphones, when they connect on their
+    // own, configure AAC and do not fall back to SBC once that is refused: they
+    // never reconnect after being switched on or after the Kindle wakes. An
+    // outgoing connection lets this side pick the codec, as a tap in Settings
+    // does. Once per device in RETRY_WINDOW_MS, so a device that keeps failing
+    // is not called in a loop; only for bonded devices with A2DP allowed.
+    private static final int RETRY_DELAY_MS = 2000;
+    private static final long RETRY_WINDOW_MS = 10000;
+    private BluetoothDevice mRetryDevice;
+    private long mRetryAtMs;
+
+    private void retryIncomingAsOutgoing(BluetoothDevice device) {
+        long now = android.os.SystemClock.elapsedRealtime();
+        if (device.equals(mRetryDevice) && now - mRetryAtMs < RETRY_WINDOW_MS) return;
+        if (device.getBondState() != BluetoothDevice.BOND_BONDED
+                || mService.getPriority(device) <= BluetoothProfile.PRIORITY_OFF) return;
+        mRetryDevice = device;
+        mRetryAtMs = now;
+        logi("Incoming A2DP failed; connecting from this side in " + RETRY_DELAY_MS + " ms");
+        sendMessageDelayed(obtainMessage(CONNECT, device), RETRY_DELAY_MS);
+    }
+

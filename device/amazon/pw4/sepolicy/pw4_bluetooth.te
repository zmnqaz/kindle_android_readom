# PW4 Bluetooth HAL (android.hardware.bluetooth@1.0-service with
# libbt-vendor): reads the stock patch RAM file from /firmware/bluetooth, the
# device's own file like the Wi-Fi firmware (pw4_hardware.te). The tty
# (hci_attach_dev), rfkill state (sysfs_bluetooth_writable) and wake locks
# are already allowed by AOSP's public/hal_bluetooth.te.
allow hal_bluetooth_default pw3_private_firmware_file:dir r_dir_perms;
allow hal_bluetooth_default pw3_private_firmware_file:file r_file_perms;
# LPM (kernel bt-lpm, vnd_pw4.txt BT_WAKE_VIA_PROC): libbt writes
# /proc/bluetooth/sleep/lpm and btwrite (hardware/broadcom/libbt/src/upio.c:
# 61-67). The files are allowed by public/hal_bluetooth.te:27, but
# proc_bluetooth_writable is not a proc_type, so nothing lets the HAL walk
# the /proc/bluetooth directories (genfs_contexts labels them the same).
allow hal_bluetooth_default proc_bluetooth_writable:dir search;

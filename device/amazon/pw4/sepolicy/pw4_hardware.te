# PW4: bcmdhd reads its firmware and NVRAM itself (filp_open). The module's
# init runs in init's domain (insmod), but the SDIO probe that downloads the
# firmware runs later in a kernel worker, so both need to read them. They are
# the device's own files, under /firmware like the PW3's private assets
# (device/amazon/pw3/sepolicy).
allow init pw3_private_firmware_file:dir r_dir_perms;
allow init pw3_private_firmware_file:file r_file_perms;
allow kernel pw3_private_firmware_file:dir r_dir_perms;
allow kernel pw3_private_firmware_file:file r_file_perms;

# The power HAL locks the Goodix touch panel at screen off (/proc/touch).
type pw4_proc_touch, fs_type;
allow hal_power pw4_proc_touch:file w_file_perms;

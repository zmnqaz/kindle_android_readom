<?xml version="1.0" encoding="utf-8"?>
<!-- PW4: A2DP source (with AVRCP target, which A2DP brings) and GATT only.
     GATT stays: BluetoothManagerService's enable path waits for GattService
     (frameworks/base/services/core/java/com/android/server/
     BluetoothManagerService.java). Defaults in packages/apps/Bluetooth/res/
     values/config.xml:16-33. No HFP: there is no PCM/I2S path to the chip. -->
<resources>
    <bool name="profile_supported_a2dp">true</bool>
    <bool name="profile_supported_a2dp_sink">false</bool>
    <bool name="profile_supported_hdp">false</bool>
    <bool name="profile_supported_hs_hfp">false</bool>
    <bool name="profile_supported_hfpclient">false</bool>
    <bool name="profile_supported_hid">false</bool>
    <bool name="profile_supported_opp">false</bool>
    <bool name="profile_supported_pan">false</bool>
    <bool name="profile_supported_pbap">false</bool>
    <bool name="profile_supported_gatt">true</bool>
    <bool name="profile_supported_map">false</bool>
    <bool name="profile_supported_avrcp_controller">false</bool>
    <bool name="profile_supported_sap">false</bool>
    <bool name="profile_supported_pbapclient">false</bool>
    <bool name="profile_supported_mapmce">false</bool>
    <bool name="profile_supported_hidd">false</bool>
    <!-- SBC only (-1 disables a codec). The single 1 GHz core has no room
         for the AAC encoder while the reader also draws pages: with audio
         playing, page turns took 0.5 to 4 s and some taps got no answer
         within 5 s (Jump 55, 2026-11-26). For spoken books SBC is enough. -->
    <integer name="a2dp_source_codec_priority_sbc">1001</integer>
    <integer name="a2dp_source_codec_priority_aac">-1</integer>
    <integer name="a2dp_source_codec_priority_aptx">-1</integer>
    <integer name="a2dp_source_codec_priority_aptx_hd">-1</integer>
    <integer name="a2dp_source_codec_priority_ldac">-1</integer>
</resources>

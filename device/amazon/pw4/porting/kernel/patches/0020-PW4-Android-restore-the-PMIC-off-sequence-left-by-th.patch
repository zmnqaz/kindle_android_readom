From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pw4-port <pw4-port@localhost>
Date: Tue, 24 Nov 2026 10:41:46 +0800
Subject: [PATCH] PW4 Android: restore the PMIC off sequence left by the stock
 suspend

The kernel starts from a stock suspend after bd71827 suspend_late disabled
the power-off sequence; resume_early never runs, so redo it at probe.
Diagnosis: pw4_usbwatch logs USB/VBUS/PMIC_INT_B register changes each ms.
---
 drivers/mfd/bd71827.c       | 29 ++++++++++++
 drivers/misc/Makefile       |  1 +
 drivers/misc/pw4_usbwatch.c | 89 +++++++++++++++++++++++++++++++++++++
 3 files changed, 119 insertions(+)
 create mode 100644 drivers/misc/pw4_usbwatch.c

diff --git a/drivers/mfd/bd71827.c b/drivers/mfd/bd71827.c
index 03038bff..f97e38b4 100755
--- a/drivers/mfd/bd71827.c
+++ b/drivers/mfd/bd71827.c
@@ -344,6 +344,34 @@ struct bd71827_board *bd71827_parse_dt(struct i2c_client *client,
  *  @retval 0 probe success
  *  @retval negative error number
  */
+/*
+ * PW4 Android: the kernel starts from inside a stock suspend (syscore stage),
+ * after bd71827_i2c_suspend_late() put the PMIC's power-off sequence into its
+ * suspend setting; the stock resume_early that undoes it never runs. Restore
+ * the normal setting here, as resume_early would.
+ */
+static void bd71827_restore_off_sequence(struct bd71827 *bd71827)
+{
+	struct i2c_client *client = bd71827->i2c_client;
+	u8 val = 0;
+	int ret;
+
+	i2c_lock_adapter(client->adapter);
+	ret = bd71827_enter_test_mode(client);
+	if (!ret) {
+		ret = bd71827_read_i2c_reg(client, BD71827_TEST_REG_POWER_SEQ_REG, &val);
+		if (!ret && val != BD71827_TEST_REG_ENABLE_OFF_SEQUENCE)
+			ret = bd71827_write_i2c_reg(client, BD71827_TEST_REG_POWER_SEQ_REG,
+						    BD71827_TEST_REG_ENABLE_OFF_SEQUENCE);
+		bd71827_exit_test_mode(client);
+	}
+	i2c_unlock_adapter(client->adapter);
+	if (!ret)
+		udelay(2000);
+	dev_info(bd71827->dev, "pw4: power sequence register was %#x, restore %d\n",
+		 val, ret);
+}
+
 static int bd71827_i2c_probe(struct i2c_client *i2c,
 			    const struct i2c_device_id *id)
 {
@@ -394,6 +422,7 @@ static int bd71827_i2c_probe(struct i2c_client *i2c,
 	}
 	dev_info(bd71827->dev, "Device ID=0x%X\n", ret);
 
+	bd71827_restore_off_sequence(bd71827);
 	bd71827_irq_init(bd71827, of_pmic_plat_data);
 
 	ret = mfd_add_devices(bd71827->dev, -1,
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index 0f6d219c..9d073cb8 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -63,3 +63,4 @@ obj-$(CONFIG_CXL_BASE)		+= cxl/
 obj-$(CONFIG_FRONTLIGHT)	+= frontlight.o
 obj-$(CONFIG_IDME)		+= idme.o
 obj-$(CONFIG_UID_CPUTIME) += uid_cputime.o
+obj-y				+= pw4_usbwatch.o
diff --git a/drivers/misc/pw4_usbwatch.c b/drivers/misc/pw4_usbwatch.c
new file mode 100644
index 00000000..ec29b03f
--- /dev/null
+++ b/drivers/misc/pw4_usbwatch.c
@@ -0,0 +1,89 @@
+/*
+ * PW4 diagnosis: watch the USB/VBUS hardware state every millisecond and log
+ * each change (pw4-trace: usbwatch ...). The Android port freezes when a USB
+ * cable goes in, before any interrupt handler prints; the Lab126 log keeps
+ * every line, so the last ones show what the hardware did first.
+ *
+ * Only always-clocked registers are read: CCM, anatop and the GPIO4 pad state
+ * of the PMIC interrupt line (PMIC_INT_B, GPIO4_IO24).
+ */
+#include <linux/hrtimer.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/moduleparam.h>
+
+static bool pw4_usbwatch = true;
+core_param(pw4_usbwatch, pw4_usbwatch, bool, 0444);
+
+#define CCM_BASE	0x020C4000
+#define ANATOP_BASE	0x020C8000
+#define GPIO4_BASE	0x020A8000
+
+struct watch_reg {
+	const char *name;
+	int base;	/* 0 CCM, 1 anatop, 2 GPIO4 */
+	u32 off;
+	u32 mask;
+};
+
+static const struct watch_reg regs[] = {
+	{ "usboh3_cg", 0, 0x80, 0x3 },			/* CCGR6 CG0 */
+	{ "PLL_USB1", 1, 0x10, 0xffffffff },
+	{ "REG_3P0", 1, 0x120, 0xffffffff },
+	{ "VBUS_DETECT", 1, 0x1a0, 0xffffffff },
+	{ "CHRG_DETECT", 1, 0x1b0, 0xffffffff },
+	{ "VBUS_DET_STAT", 1, 0x1c0, 0xffffffff },
+	{ "CHRG_DET_STAT", 1, 0x1d0, 0xffffffff },
+	{ "USB1_MISC", 1, 0x1f0, 0xffffffff },
+	{ "PMIC_INT_B", 2, 0x08, 1u << 24 },		/* GPIO4 PSR */
+};
+
+static void __iomem *bases[3];
+static u32 last[ARRAY_SIZE(regs)];
+static struct hrtimer timer;
+
+static u32 read_reg(int i)
+{
+	return readl_relaxed(bases[regs[i].base] + regs[i].off) & regs[i].mask;
+}
+
+static enum hrtimer_restart watch(struct hrtimer *t)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		u32 v = read_reg(i);
+
+		if (v != last[i]) {
+			pr_info("pw4-trace: usbwatch %s %08x -> %08x\n",
+				regs[i].name, last[i], v);
+			last[i] = v;
+		}
+	}
+	hrtimer_forward_now(t, ms_to_ktime(1));
+	return HRTIMER_RESTART;
+}
+
+static int __init pw4_usbwatch_init(void)
+{
+	int i;
+
+	if (!pw4_usbwatch)
+		return 0;
+	bases[0] = ioremap(CCM_BASE, 0x1000);
+	bases[1] = ioremap(ANATOP_BASE, 0x1000);
+	bases[2] = ioremap(GPIO4_BASE, 0x1000);
+	if (!bases[0] || !bases[1] || !bases[2])
+		return -ENOMEM;
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		last[i] = read_reg(i);
+		pr_info("pw4-trace: usbwatch %s %08x\n", regs[i].name, last[i]);
+	}
+	hrtimer_init(&timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	timer.function = watch;
+	hrtimer_start(&timer, ms_to_ktime(1), HRTIMER_MODE_REL);
+	return 0;
+}
+late_initcall(pw4_usbwatch_init);
-- 

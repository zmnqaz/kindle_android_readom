From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pw4-port <pw4-port@localhost>
Date: Tue, 24 Nov 2026 19:25:07 +0800
Subject: [PATCH] PW4 diagnosis: pw4_usb_runtime_pm_off keeps USB OTG1 out of
 runtime PM

---
 drivers/usb/chipidea/ci_hdrc_imx.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/usb/chipidea/ci_hdrc_imx.c b/drivers/usb/chipidea/ci_hdrc_imx.c
index b3763291..607265c6 100644
--- a/drivers/usb/chipidea/ci_hdrc_imx.c
+++ b/drivers/usb/chipidea/ci_hdrc_imx.c
@@ -28,6 +28,9 @@
 #include "ci.h"
 #include "ci_hdrc_imx.h"
 
+static bool pw4_usb_runtime_pm_off;
+core_param(pw4_usb_runtime_pm_off, pw4_usb_runtime_pm_off, bool, 0444);
+
 struct ci_hdrc_imx_platform_flag {
 	unsigned int flags;
 	bool runtime_pm;
@@ -529,6 +532,13 @@ static int ci_hdrc_imx_probe(struct platform_device *pdev)
 
 	pdata.usb_phy = data->phy;
 	pdata.flags |= imx_platform_flag->flags;
+	/* Diagnose PW4 cable-edge hangs with both OTG1 drivers kept active. */
+	if (pw4_usb_runtime_pm_off &&
+	    of_device_is_compatible(np, "fsl,imx6sll-usb") &&
+	    data->usbmisc_data && data->usbmisc_data->index == 0) {
+		pdata.flags &= ~CI_HDRC_SUPPORTS_RUNTIME_PM;
+		dev_info(&pdev->dev, "pw4: USB OTG1 runtime PM disabled\n");
+	}
 	if (pdata.flags & CI_HDRC_SUPPORTS_RUNTIME_PM)
 		data->supports_runtime_pm = true;
 
-- 

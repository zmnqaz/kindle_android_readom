From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pw4-port <pw4-port@localhost>
Date: Tue, 24 Nov 2026 20:10:33 +0800
Subject: [PATCH] PW4 diagnosis: run-time switches for idle, cpufreq and USB
 runtime PM

pw4_cpuidle_wfi and pw4_cpufreq_hold are writable under
/sys/module/kernel/parameters; pw4_usb_rpm_forbid forbids OTG1 runtime
suspend at probe (power/control=auto re-allows it).
---
 arch/arm/mach-imx/cpuidle-imx6sll.c | 10 ++++++++++
 drivers/cpufreq/imx6q-cpufreq.c     |  6 ++++++
 drivers/usb/chipidea/ci_hdrc_imx.c  | 10 ++++++++++
 3 files changed, 26 insertions(+)

diff --git a/arch/arm/mach-imx/cpuidle-imx6sll.c b/arch/arm/mach-imx/cpuidle-imx6sll.c
index 81d413ab..d0dde5bb 100644
--- a/arch/arm/mach-imx/cpuidle-imx6sll.c
+++ b/arch/arm/mach-imx/cpuidle-imx6sll.c
@@ -90,11 +90,21 @@ static int imx6sll_idle_finish(unsigned long val)
 	return 0;
 }
 
+/* PW4 diagnosis: pw4_cpuidle_wfi=1 makes every idle state a plain WFI
+ * (no WAIT mode, no ARM power-off). Writable at run time. */
+static bool pw4_cpuidle_wfi;
+core_param(pw4_cpuidle_wfi, pw4_cpuidle_wfi, bool, 0644);
+
 static int imx6sll_enter_wait(struct cpuidle_device *dev,
 			    struct cpuidle_driver *drv, int index)
 {
 	int mode = get_bus_freq_mode();
 
+	if (pw4_cpuidle_wfi) {
+		cpu_do_idle();
+		return index;
+	}
+
 	imx6q_set_lpm(WAIT_UNCLOCKED);
 	if ((index == 1) || ((mode != BUS_FREQ_LOW) && index == 2)) {
 		cpu_do_idle();
diff --git a/drivers/cpufreq/imx6q-cpufreq.c b/drivers/cpufreq/imx6q-cpufreq.c
index a183d0ce..cc0b9e80 100644
--- a/drivers/cpufreq/imx6q-cpufreq.c
+++ b/drivers/cpufreq/imx6q-cpufreq.c
@@ -77,6 +77,10 @@ EXPORT_SYMBOL_GPL(imx6q_cpufreq_power_optimization);
 /* PW4 diagnosis: pw4_cpufreq_low=1 keeps the CPU at the lowest setpoint. */
 static bool pw4_cpufreq_low;
 core_param(pw4_cpufreq_low, pw4_cpufreq_low, bool, 0444);
+/* PW4 diagnosis: pw4_cpufreq_hold=1 ignores every frequency change (the CPU
+ * stays where it is, 996 MHz after the handoff). Writable at run time. */
+static bool pw4_cpufreq_hold;
+core_param(pw4_cpufreq_hold, pw4_cpufreq_hold, bool, 0644);
 
 static int imx6q_set_target(struct cpufreq_policy *policy, unsigned int index)
 {
@@ -85,6 +89,8 @@ static int imx6q_set_target(struct cpufreq_policy *policy, unsigned int index)
 	unsigned int old_freq, new_freq;
 	int ret;
 
+	if (pw4_cpufreq_hold)
+		return 0;
 	if (pw4_cpufreq_low)
 		index = 0;
 	mutex_lock(&set_cpufreq_lock);
diff --git a/drivers/usb/chipidea/ci_hdrc_imx.c b/drivers/usb/chipidea/ci_hdrc_imx.c
index 4ecb17c6..38ace702 100644
--- a/drivers/usb/chipidea/ci_hdrc_imx.c
+++ b/drivers/usb/chipidea/ci_hdrc_imx.c
@@ -30,6 +30,10 @@
 
 static bool pw4_usb_runtime_pm_off;
 core_param(pw4_usb_runtime_pm_off, pw4_usb_runtime_pm_off, bool, 0444);
+/* PW4 diagnosis: keep the controller out of runtime suspend from probe on
+ * (pm_runtime_forbid, as power/control=on); write "auto" to re-allow. */
+static bool pw4_usb_rpm_forbid;
+core_param(pw4_usb_rpm_forbid, pw4_usb_rpm_forbid, bool, 0444);
 
 struct ci_hdrc_imx_platform_flag {
 	unsigned int flags;
@@ -622,6 +626,12 @@ static int ci_hdrc_imx_probe(struct platform_device *pdev)
 		goto disable_hsic_regulator;
 	}
 
+	if (pw4_usb_rpm_forbid && data->usbmisc_data &&
+	    data->usbmisc_data->index == 0) {
+		pm_runtime_forbid(&data->ci_pdev->dev);
+		dev_info(&pdev->dev, "pw4: USB OTG1 runtime suspend forbidden\n");
+	}
+
 	ret = imx_usbmisc_init_post(data->usbmisc_data);
 	if (ret) {
 		dev_err(&pdev->dev, "usbmisc post failed, ret=%d\n", ret);
-- 
2.53.0


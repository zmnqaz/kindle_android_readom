From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pw4-port <pw4-port@localhost>
Date: Wed, 25 Nov 2026 13:20:59 +0800
Subject: [PATCH 20/22] PW4 Android: bound the UDC busy waits by count

The udc busy waits run with the controller lock held and interrupts off.
On the single core jiffies stand still there, so Lab126's 200 ms limits
never expire. Bound every wait by an iteration count and log which one
gave up.
---
 drivers/usb/chipidea/udc.c | 89 +++++++++++++++++++++++++++++---------
 1 file changed, 69 insertions(+), 20 deletions(-)

diff --git a/drivers/usb/chipidea/udc.c b/drivers/usb/chipidea/udc.c
index 0cbd87bc..5729cc1b 100644
--- a/drivers/usb/chipidea/udc.c
+++ b/drivers/usb/chipidea/udc.c
@@ -91,6 +91,21 @@ static int hw_device_state(struct ci_hdrc *ci, u32 dma)
 	return 0;
 }
 
+/*
+ * PW4: the busy waits below run with the controller lock held and interrupts
+ * off; on the single core jiffies stand still there, so Lab126's 200 ms
+ * limits never expire and a register that never clears would hang the SoC
+ * silently. Bound them by count and say which one gave up.
+ */
+#define PW4_SPIN_MAX 2000000
+static void pw4_stuck(struct ci_hdrc *ci, const char *what, int bit)
+{
+	pr_err("ci_hdrc udc: busy wait gave up in %s bit %d: cmd %08x sts %08x portsc %08x prime %08x flush %08x stat %08x\n",
+	       what, bit, hw_read(ci, OP_USBCMD, ~0), hw_read(ci, OP_USBSTS, ~0),
+	       hw_read(ci, OP_PORTSC, ~0), hw_read(ci, OP_ENDPTPRIME, ~0),
+	       hw_read(ci, OP_ENDPTFLUSH, ~0), hw_read(ci, OP_ENDPTSTAT, ~0));
+}
+
 /**
  * hw_ep_flush: flush endpoint fifo (execute without interruption)
  * @num: endpoint number
@@ -103,7 +118,7 @@ static int hw_ep_flush(struct ci_hdrc *ci, int num, int dir)
 	int n = hw_ep_bit(num, dir);
 #ifdef CONFIG_LAB126
 	int loopn;
-	unsigned int time_msec = jiffies_to_msecs(jiffies);
+	int outer = 0;
 #endif
 
 	do {
@@ -114,9 +129,9 @@ static int hw_ep_flush(struct ci_hdrc *ci, int num, int dir)
 			cpu_relax();
 		}
 
-		// Don't loop forever - causes wdg
-		if ((jiffies_to_msecs(jiffies) - time_msec) > 200) {
-			printk(KERN_ERR "%s:%d Infinite Loop\n", __FUNCTION__, __LINE__);
+		// Don't loop forever - causes wdg (by count: no jiffies with irqs off)
+		if (++outer > PW4_SPIN_MAX / 1000) {
+			pw4_stuck(ci, "ep_flush", n);
 			return 0;
 		}
 #else
@@ -209,8 +224,17 @@ static int hw_ep_prime(struct ci_hdrc *ci, int num, int dir, int is_ctrl)
 
 	hw_write(ci, OP_ENDPTPRIME, ~0, BIT(n));
 
-	while (hw_read(ci, OP_ENDPTPRIME, BIT(n)))
-		cpu_relax();
+	{
+		int spin = 0;
+
+		while (hw_read(ci, OP_ENDPTPRIME, BIT(n))) {
+			cpu_relax();
+			if (++spin > PW4_SPIN_MAX) {
+				pw4_stuck(ci, "ep_prime", n);
+				break;
+			}
+		}
+	}
 	if (is_ctrl && dir == RX && hw_read(ci, OP_ENDPTSETUPSTAT, BIT(num)))
 		return -EAGAIN;
 
@@ -230,7 +254,7 @@ static int hw_ep_prime(struct ci_hdrc *ci, int num, int dir, int is_ctrl)
 static int hw_ep_set_halt(struct ci_hdrc *ci, int num, int dir, int value)
 {
 #ifdef CONFIG_LAB126
-	unsigned int time_msec = jiffies_to_msecs(jiffies);
+	int spin = 0;
 #endif
 
 	if (value != 0 && value != 1)
@@ -246,9 +270,9 @@ static int hw_ep_set_halt(struct ci_hdrc *ci, int num, int dir, int value)
 			  value ? mask_xs : mask_xr);
 
 #ifdef CONFIG_LAB126
-		// Don't loop forever - causes wdg
-		if ((jiffies_to_msecs(jiffies) - time_msec) > 200) {
-			printk(KERN_ERR "%s:%d Infinite Loop\n", __FUNCTION__, __LINE__);
+		// Don't loop forever - causes wdg (by count: no jiffies with irqs off)
+		if (++spin > PW4_SPIN_MAX) {
+			pw4_stuck(ci, "ep_set_halt", num);
 			return -EINVAL;
 		}
 #endif
@@ -350,8 +374,17 @@ static int hw_usb_reset(struct ci_hdrc *ci)
 	hw_write(ci, OP_ENDPTCOMPLETE,  0,  0);
 
 	/* wait until all bits cleared */
-	while (hw_read(ci, OP_ENDPTPRIME, ~0))
-		udelay(10);             /* not RTOS friendly */
+	{
+		int spin = 0;
+
+		while (hw_read(ci, OP_ENDPTPRIME, ~0)) {
+			udelay(10);             /* not RTOS friendly */
+			if (++spin > 20000) {
+				pw4_stuck(ci, "usb_reset prime", -1);
+				break;
+			}
+		}
+	}
 
 	/* reset all endpoints ? */
 
@@ -512,10 +545,18 @@ static int _hardware_enqueue(struct ci_hw_ep *hwep, struct ci_hw_req *hwreq)
 		wmb();
 		if (hw_read(ci, OP_ENDPTPRIME, BIT(n)))
 			goto done;
-		do {
-			hw_write(ci, OP_USBCMD, USBCMD_ATDTW, USBCMD_ATDTW);
-			tmp_stat = hw_read(ci, OP_ENDPTSTAT, BIT(n));
-		} while (!hw_read(ci, OP_USBCMD, USBCMD_ATDTW));
+		{
+			int spin = 0;
+
+			do {
+				hw_write(ci, OP_USBCMD, USBCMD_ATDTW, USBCMD_ATDTW);
+				tmp_stat = hw_read(ci, OP_ENDPTSTAT, BIT(n));
+				if (++spin > PW4_SPIN_MAX) {
+					pw4_stuck(ci, "atdtw", n);
+					break;
+				}
+			} while (!hw_read(ci, OP_USBCMD, USBCMD_ATDTW));
+		}
 		hw_write(ci, OP_USBCMD, USBCMD_ATDTW, 0);
 		if (tmp_stat)
 			goto done;
@@ -1107,10 +1148,18 @@ __acquires(ci->lock)
 	_ep_nuke(ci->ep0in);
 
 	/* read_setup_packet */
-	do {
-		hw_test_and_set_setup_guard(ci);
-		memcpy(&req, &hwep->qh.ptr->setup, sizeof(req));
-	} while (!hw_test_and_clear_setup_guard(ci));
+	{
+		int spin = 0;
+
+		do {
+			hw_test_and_set_setup_guard(ci);
+			memcpy(&req, &hwep->qh.ptr->setup, sizeof(req));
+			if (++spin > PW4_SPIN_MAX) {
+				pw4_stuck(ci, "setup_guard", 0);
+				break;
+			}
+		} while (!hw_test_and_clear_setup_guard(ci));
+	}
 
 	type = req.bRequestType;
 
-- 

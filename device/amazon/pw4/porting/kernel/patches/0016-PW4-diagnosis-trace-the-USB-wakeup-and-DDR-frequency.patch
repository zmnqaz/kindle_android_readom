From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pw4-port <pw4-port@localhost>
Date: Tue, 24 Nov 2026 00:28:05 +0800
Subject: [PATCH] PW4 diagnosis: trace the USB wakeup and DDR frequency changes

Plugging USB under Android froze the PW4 without a message. The USB
wakeup resume and every bus frequency change now log a line, and the
pw4_busfreq_off parameter keeps DDR at its starting frequency.
---
 arch/arm/mach-imx/busfreq-imx.c    | 16 ++++++++++++++++
 drivers/usb/chipidea/ci_hdrc_imx.c |  4 ++++
 drivers/usb/chipidea/core.c        |  4 ++++
 3 files changed, 24 insertions(+)

diff --git a/arch/arm/mach-imx/busfreq-imx.c b/arch/arm/mach-imx/busfreq-imx.c
index 50d06ef3..8ab69289 100644
--- a/arch/arm/mach-imx/busfreq-imx.c
+++ b/arch/arm/mach-imx/busfreq-imx.c
@@ -679,6 +679,7 @@ static void exit_lpm_imx7d(void)
 
 static void reduce_bus_freq(void)
 {
+	pr_info("pw4-trace: busfreq low begin (high %d audio %d)\n", high_bus_count, audio_bus_count);
 	mutex_lock(&cpu_freq_lock);
 	if (cpu_is_imx6())
 		clk_prepare_enable(pll3_clk);
@@ -702,6 +703,8 @@ static void reduce_bus_freq(void)
 
 	if (cpu_is_imx6())
 		clk_disable_unprepare(pll3_clk);
+	pr_info("pw4-trace: busfreq low done (audio %d low %d ultra %d)\n",
+		audio_bus_freq_mode, low_bus_freq_mode, ultra_low_bus_freq_mode);
 
 	if (audio_bus_freq_mode)
 		dev_dbg(busfreq_dev,
@@ -820,6 +823,8 @@ static int set_high_bus_freq(int high_bus_freq)
 	if (med_bus_freq_mode && !high_bus_freq)
 		return 0;
 
+	pr_info("pw4-trace: busfreq high begin (low %d ultra %d audio %d)\n",
+		low_bus_freq_mode, ultra_low_bus_freq_mode, audio_bus_freq_mode);
 	if (low_bus_freq_mode || ultra_low_bus_freq_mode)
 		busfreq_notify(LOW_BUSFREQ_EXIT);
 
@@ -843,6 +848,7 @@ static int set_high_bus_freq(int high_bus_freq)
 
 	if (cpu_is_imx6())
 		clk_disable_unprepare(pll3_clk);
+	pr_info("pw4-trace: busfreq high done\n");
 
 	if (high_bus_freq_mode)
 		dev_dbg(busfreq_dev,
@@ -1151,6 +1157,9 @@ static DEVICE_ATTR(enable, 0644, bus_freq_scaling_enable_show,
  *
  */
 
+static bool pw4_busfreq_off;
+core_param(pw4_busfreq_off, pw4_busfreq_off, bool, 0444);
+
 static int busfreq_probe(struct platform_device *pdev)
 {
 	u32 err;
@@ -1313,6 +1322,13 @@ static int busfreq_probe(struct platform_device *pdev)
 
 	bus_freq_scaling_is_active = 1;
 	bus_freq_scaling_initialized = 1;
+	/* PW4 Android, diagnosis of the USB plug freeze: with pw4_busfreq_off
+	 * the DDR stays at the frequency it starts at (high: the stock kernel
+	 * sets it before the suspend the handoff starts from). */
+	if (pw4_busfreq_off) {
+		bus_freq_scaling_is_active = 0;
+		pr_info("pw4-trace: busfreq scaling off (pw4_busfreq_off)\n");
+	}
 
 	ddr_low_rate = LPAPM_CLK;
 
diff --git a/drivers/usb/chipidea/ci_hdrc_imx.c b/drivers/usb/chipidea/ci_hdrc_imx.c
index e3c22730..b3763291 100644
--- a/drivers/usb/chipidea/ci_hdrc_imx.c
+++ b/drivers/usb/chipidea/ci_hdrc_imx.c
@@ -708,15 +708,18 @@ static int imx_controller_resume(struct device *dev)
 		return 0;
 	}
 
+	pr_info("pw4-trace: imx resume: bus freq\n");
 	if (!test_and_set_bit(HIGH_BUS_FREQ, &data->bitflags)) {
 		request_bus_freq(BUS_FREQ_HIGH);
 	}
+	pr_info("pw4-trace: imx resume: clocks\n");
 	ret = imx_prepare_enable_clks(dev);
 	if (ret)
 		return ret;
 
 	data->in_lpm = false;
 
+	pr_info("pw4-trace: imx resume: usbmisc\n");
 	ret = imx_usbmisc_power_lost_check(data->usbmisc_data);
 	/* re-init if resume from power lost */
 	if (ret > 0) {
@@ -739,6 +742,7 @@ static int imx_controller_resume(struct device *dev)
 		dev_err(dev, "usbmisc hsic_set_clk failed, ret=%d\n", ret);
 		goto hsic_set_clk_fail;
 	}
+	pr_info("pw4-trace: imx resume: done\n");
 
 	return 0;
 
diff --git a/drivers/usb/chipidea/core.c b/drivers/usb/chipidea/core.c
index 9fc93781..55940510 100644
--- a/drivers/usb/chipidea/core.c
+++ b/drivers/usb/chipidea/core.c
@@ -554,6 +554,7 @@ static irqreturn_t ci_irq(int irq, void *data)
 	u32 otgsc = 0;
 
 	if (ci->in_lpm) {
+		pr_info("pw4-trace: usb wakeup irq\n");
 		disable_irq_nosync(irq);
 		ci->wakeup_int = true;
 		pm_runtime_get(ci->dev);
@@ -1168,12 +1169,15 @@ static int ci_controller_resume(struct device *dev)
 		return 0;
 	}
 
+	pr_info("pw4-trace: ci resume: leave lpm\n");
 	ci_hdrc_enter_lpm(ci, false);
+	pr_info("pw4-trace: ci resume: phy\n");
 	if (ci->usb_phy) {
 		usb_phy_set_suspend(ci->usb_phy, 0);
 		usb_phy_set_wakeup(ci->usb_phy, false);
 		hw_wait_phy_stable();
 	}
+	pr_info("pw4-trace: ci resume: done\n");
 
 	ci->in_lpm = false;
 	if (ci->wakeup_int) {
-- 
2.53.0


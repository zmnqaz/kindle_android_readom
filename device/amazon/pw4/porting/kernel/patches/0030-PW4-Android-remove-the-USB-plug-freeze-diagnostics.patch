diff --git a/drivers/misc/pw4_lockup.c b/drivers/misc/pw4_lockup.c
index eb9abf62..9a8498c1 100644
--- a/drivers/misc/pw4_lockup.c
+++ b/drivers/misc/pw4_lockup.c
@@ -1,6 +1,7 @@
 /*
- * PW4 diagnosis: tell a bus hang from an interrupt storm in the USB plug
- * freeze. EPIT2 (32 kHz) interrupts every 0.5 s at the highest GIC priority,
+ * PW4 diagnosis, off unless booted with pw4_lockup=1: tell a bus hang from an
+ * interrupt storm when the device freezes without a log line (this found the
+ * UART wake interrupt storm behind the USB plug freeze). EPIT2 (32 kHz) interrupts every 0.5 s at the highest GIC priority,
  * so it still gets in when another interrupt keeps the CPU busy. When jiffies
  * stop for a second it logs the interrupts that counted fastest and the
  * interrupted registers (pw4-lockup: ...). Nothing logged after a freeze
@@ -24,7 +25,7 @@
 #include <asm/irq_regs.h>
 #include <dt-bindings/clock/imx6sll-clock.h>
 
-static bool pw4_lockup = true;
+static bool pw4_lockup;
 core_param(pw4_lockup, pw4_lockup, bool, 0444);
 
 #define EPIT_CR		0x00
diff --git a/drivers/misc/pw4_usbwatch.c b/drivers/misc/pw4_usbwatch.c
deleted file mode 100644
index 4903bc22..00000000
--- a/drivers/misc/pw4_usbwatch.c
+++ /dev/null
@@ -1,113 +0,0 @@
-/*
- * PW4 diagnosis: watch the USB/VBUS hardware state every millisecond and log
- * each change (pw4-trace: usbwatch ...). The Android port freezes when a USB
- * cable goes in, before any interrupt handler prints; the Lab126 log keeps
- * every line, so the last ones show what the hardware did first.
- *
- * CCM, anatop and the GPIO4 pad state of the PMIC interrupt line
- * (PMIC_INT_B, GPIO4_IO24) are always clocked; the OTG1 controller registers
- * are read only while its clock gate (usboh3) is on.
- */
-#include <linux/hrtimer.h>
-#include <linux/init.h>
-#include <linux/io.h>
-#include <linux/kernel.h>
-#include <linux/ktime.h>
-#include <linux/moduleparam.h>
-
-static bool pw4_usbwatch = true;
-core_param(pw4_usbwatch, pw4_usbwatch, bool, 0444);
-
-#define CCM_BASE	0x020C4000
-#define ANATOP_BASE	0x020C8000
-#define GPIO4_BASE	0x020A8000
-#define USB_BASE	0x02184000
-#define USBPHY1_BASE	0x020C9000
-
-struct watch_reg {
-	const char *name;
-	int base;	/* 0 CCM, 1 anatop, 2 GPIO4, 3 OTG1 (gated), 4 USBPHY1 */
-	u32 off;
-	u32 mask;
-};
-
-static const struct watch_reg regs[] = {
-	{ "usboh3_cg", 0, 0x80, 0x3 },			/* CCGR6 CG0 */
-	{ "PLL_USB1", 1, 0x10, 0xffffffff },
-	{ "REG_3P0", 1, 0x120, 0xffffffff },
-	{ "VBUS_DETECT", 1, 0x1a0, 0xffffffff },
-	{ "CHRG_DETECT", 1, 0x1b0, 0xffffffff },
-	{ "VBUS_DET_STAT", 1, 0x1c0, 0xffffffff },
-	{ "CHRG_DET_STAT", 1, 0x1d0, 0xffffffff },
-	{ "USB1_MISC", 1, 0x1f0, 0xffffffff },
-	{ "PMIC_INT_B", 2, 0x08, 1u << 24 },		/* GPIO4 PSR */
-	{ "USBCMD", 3, 0x140, ~0x6000u },		/* not SUTW/ATDTW */
-	{ "USBSTS", 3, 0x144, 0x1144 },			/* PCI URI SLI HCH */
-	{ "USBINTR", 3, 0x148, ~0u },
-	{ "PORTSC", 3, 0x184, ~0xc00u },		/* not the line state */
-	{ "OTGSC", 3, 0x1a4, 0x005f1f00 },		/* not the 1 ms timer */
-	/* not the USBPHY1 registers: read while the PHY is gated they return
-	 * bus garbage */
-};
-
-static void __iomem *bases[5];
-static u32 last[ARRAY_SIZE(regs)];
-static struct hrtimer timer;
-
-static bool usb_clocked(void)
-{
-	return (readl_relaxed(bases[0] + 0x80) & 0x3) == 0x3;	/* CCGR6 CG0 */
-}
-
-static u32 read_reg(int i)
-{
-	return readl_relaxed(bases[regs[i].base] + regs[i].off) & regs[i].mask;
-}
-
-static enum hrtimer_restart watch(struct hrtimer *t)
-{
-	int i;
-	bool usb = usb_clocked();
-
-	for (i = 0; i < ARRAY_SIZE(regs); i++) {
-		u32 v;
-
-		if (regs[i].base == 3 && !usb)
-			continue;
-		v = read_reg(i);
-
-		if (v != last[i]) {
-			pr_info("pw4-trace: usbwatch %s %08x -> %08x\n",
-				regs[i].name, last[i], v);
-			last[i] = v;
-		}
-	}
-	hrtimer_forward_now(t, ms_to_ktime(1));
-	return HRTIMER_RESTART;
-}
-
-static int __init pw4_usbwatch_init(void)
-{
-	int i;
-
-	if (!pw4_usbwatch)
-		return 0;
-	bases[0] = ioremap(CCM_BASE, 0x1000);
-	bases[1] = ioremap(ANATOP_BASE, 0x1000);
-	bases[2] = ioremap(GPIO4_BASE, 0x1000);
-	bases[3] = ioremap(USB_BASE, 0x1000);
-	bases[4] = ioremap(USBPHY1_BASE, 0x1000);
-	if (!bases[0] || !bases[1] || !bases[2] || !bases[3] || !bases[4])
-		return -ENOMEM;
-	for (i = 0; i < ARRAY_SIZE(regs); i++) {
-		if (regs[i].base == 3 && !usb_clocked())
-			continue;
-		last[i] = read_reg(i);
-		pr_info("pw4-trace: usbwatch %s %08x\n", regs[i].name, last[i]);
-	}
-	hrtimer_init(&timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
-	timer.function = watch;
-	hrtimer_start(&timer, ms_to_ktime(1), HRTIMER_MODE_REL);
-	return 0;
-}
-late_initcall(pw4_usbwatch_init);

# CONFIG_SYSCTL_SYSCALL is not set
# CONFIG_USER_NS is not set
CONFIG_STRICT_DEVMEM=y
# PW4: 18, not PW3's 15. The rule is android-core.config's: the ring sits at
# the Lab126 fixed address (0x9be00000 here) and the stock kernel that boots
# next reads its own log_buf_len from there into /proc/printkbuf. The PW4 stock
# kernel's is 256 KB (CONFIG_LOG_BUF_SHIFT=18, LOG_GOAL_SIZE 0x40000); with 32 KB
# the first handoff's log was cut at 11.8 KB.
CONFIG_LOG_BUF_SHIFT=18

# Requested by the PW3 fragment but absent from 4.1 (added by Readom patches,
# PW3 hardware, or removed/renamed upstream):
#   CONFIG_EXPERIMENTAL=y
#   CONFIG_RESOURCE_COUNTERS=y
#   CONFIG_EXT4_FS_XATTR=y
#   CONFIG_ARM_MMAP_BASE_RANDOMIZATION=y
#   CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
#   # CONFIG_ANDROID_LOW_MEMORY_KILLER_RBTREE is not set
#   CONFIG_RTC_DRV_MAX77696=y
#   CONFIG_USB_GADGET_ARC=y
#   CONFIG_USB_ARC=m
#   CONFIG_USB_GADGET_DUALSPEED=y
#   CONFIG_USB_G_ANDROID=m
#   CONFIG_WARIO_HALL_INPUT=y
#   CONFIG_LAB126_ANDROID_DISABLE_TOUCH_FW_UPDATE=y
#   CONFIG_CYPRESS_CYTTSP4_BUS=y
#   CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4=m
#   CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_I2C=m
#   CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_MT_B=m
#   # CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_LOADER is not set
#   # CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_DEVICE_ACCESS is not set
#   # CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_DEBUG_MODULE is not set
#   # CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_INCLUDE_FW is not set
#   # CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP4_AUTO_LOAD_TOUCH_PARAMS is not set
#   # CONFIG_IP_NF_TARGET_ULOG is not set
#   CONFIG_IPV6_PRIVACY=y
#   CONFIG_LAB126_ANDROID_EPDC=y
#   CONFIG_ANDROID_GID_NET_CAPABILITIES=y
#   CONFIG_ANDROID_INET_GROUP_PERMISSION=y
#   CONFIG_LAB126_ANDROID_PMIC_I2C_STRICT=y
#   CONFIG_LAB126_ANDROID_PRIVATE_IDENTIFIERS=y

# PW4 specifics (draft)
# 2G/2G split: the architecture ceiling for mmap randomisation is lower than PW3's 16 (1010 not yet ported)
CONFIG_LOCALVERSION="-lab126-pw4-android81"
# 0015: frontlight blanking (ti-lmu/lm3695) and battery temperature units (bd71827)
CONFIG_LAB126_ANDROID_POWER_SUPPLY_ABI=y
CONFIG_LAB126_ANDROID_BACKLIGHT_BLANKING=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
# i.MX6SLL has no GPU core; galcore also fails to build once ANDROID/SYNC is on
# CONFIG_MXC_GPU_VIV is not set
# Android's own socket and capability rules by group (AID_INET 3003, AID_NET_RAW 3004,
# AID_NET_ADMIN 3005): this tree has the standard implementation (af_inet, af_inet6,
# commoncap, tun); stock leaves it off. Stands in for Readom's 0402/0600 and their
# ANDROID_INET_GROUP_PERMISSION / ANDROID_GID_NET_CAPABILITIES on PW3.
CONFIG_ANDROID_PARANOID_NETWORK=y
# Android 8.1 init (system/core/init/init.cpp, set_mmap_rnd_bits_action) insists on 16
# bits of mmap randomisation on 32-bit ARM and calls security_failure() otherwise. Stock
# PW4 runs 2G/2G, where upstream e0c25d958f78 caps ARM at 15 bits. This kernel is our own
# (the handover runs in the stock 2G/2G kernel and does not care what split the next one
# uses), so use 3G/1G as PW3 does: 512 MiB of RAM is all lowmem either way, user space
# gets 3 GiB, and 16 bits is allowed. Kernel patch 0010 provides ARCH_MMAP_RND_BITS;
# this stands in for Readom's 1010 and its ARM_MMAP_BASE_RANDOMIZATION.
#
# 2026-11-23: 3G/1G stays. Under it the Falcon storage BIOS is not found
# (fbios.c uses the BIOS's physical address 0x9ffc0000 as a kernel virtual
# address), and under 2G/2G, where it is, re-initialising a BIOS the stock
# kernel had already set up hung (sixth handoff). The next kernel does not use
# Falcon at all: "nofalcon" on the command line and kernel patch 0012 let the
# standard sdhci-esdhc-imx driver take the eMMC host, which the stock tree's
# "nofalcon" property already provides for.
CONFIG_VMSPLIT_3G=y
# CONFIG_VMSPLIT_2G is not set
CONFIG_ARCH_MMAP_RND_BITS=16

# zImage 用 gzip：交接模块的解压占用推导（boot/handoff/derive_kernel_footprint.py）核对的是 gzip 内容
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_LZO is not set
# PW4 (2026-11-25): no user-helper fallback. The 4.1 firmware cache re-requests the EPDC firmware before every suspend; the file is gone by then, the fallback uevent wakes healthd and every suspend aborts ("Wakeup pending").
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
